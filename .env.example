# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origin(s) the site is reached at, for CSRF on form posts.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8020
SITE_BASE_URL=http://localhost:8020
PORT=8020

# Email (contact form + order confirmations). Leave EMAIL_HOST blank to print emails to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fed Cove Farm <hello@fedcove.farm>
# Where new orders / contact messages are sent.
FARM_NOTIFY_EMAIL=hello@fedcove.farm

# --- Google Calendar ---
# Option A (read + write, recommended): a service account that the farm calendar is shared with
# ("Make changes to events"). Put its JSON key in ./secrets/ and set both values below.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-service-account.json
# Option B (read only, no Google Cloud setup): the calendar's "Secret address in iCal format".
GOOGLE_CALENDAR_ICS_URL=
# Minutes between automatic pulls.
CALENDAR_SYNC_MINUTES=10
